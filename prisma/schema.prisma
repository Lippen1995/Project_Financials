  MANUAL_REVIEW
}

model User {
  id                              String                            @id @default(cuid())
  name                            String?
  email                           String                            @unique
  emailVerified                   DateTime?
  passwordHash                    String?
  image                           String?
  lastWorkspaceId                 String?
  appRole                         AppRole                           @default(USER)
  createdAt                       DateTime                          @default(now())
  updatedAt                       DateTime                          @updatedAt
  accounts                        Account[]
  sessions                        Session[]
  profile                         UserProfile?
  subscription                    Subscription?
  lastWorkspace                   Workspace?                        @relation("LastWorkspace", fields: [lastWorkspaceId], references: [id], onDelete: SetNull)
  personalWorkspace               Workspace?                        @relation("PersonalWorkspaceOwner")
  workspaceMemberships            WorkspaceMember[]
  sentWorkspaceInvitations        WorkspaceInvitation[]             @relation("WorkspaceInvitationInvitedBy")
  acceptedWorkspaceInvitations    WorkspaceInvitation[]             @relation("WorkspaceInvitationAcceptedBy")
  ddPosts                         DdPost[]
  assignedDdTasks                 DdTask[]                          @relation("DdTaskAssignee")
  createdDdTasks                  DdTask[]                          @relation("DdTaskCreatedBy")
  createdDdMandates               DdMandate[]                       @relation("DdMandateCreatedBy")
  updatedDdMandates               DdMandate[]                       @relation("DdMandateUpdatedBy")
  assignedDdFindings              DdFinding[]                       @relation("DdFindingAssignee")
  createdDdFindings               DdFinding[]                       @relation("DdFindingCreatedBy")
  createdDdFindingEvidence        DdFindingEvidence[]               @relation("DdFindingEvidenceCreatedBy")
  createdDdConclusions            DdConclusion[]                    @relation("DdConclusionCreatedBy")
  updatedDdConclusions            DdConclusion[]                    @relation("DdConclusionUpdatedBy")
  ddDecisionLogEntries            DdDecisionLogEntry[]              @relation("DdDecisionLogEntryCreatedBy")
  ddCommentThreads                DdCommentThread[]                 @relation("DdCommentThreadCreatedBy")
  ddComments                      DdComment[]                       @relation("DdCommentAuthor")
  annualReportReviewDecisions     AnnualReportReviewDecision[]      @relation("ReviewDecisionReviewer")
  pdfTrainingLabels               PdfTrainingLabel[]                @relation("TrainingLabelReviewer")
  annualReportReviewedFacts       AnnualReportReviewedFact[]        @relation("ReviewedFactReviewer")
  unifiedExtractionReviewFeedback UnifiedExtractionReviewFeedback[] @relation("UnifiedExtractionReviewFeedbackReviewer")
  pdfDecisionGoldSetCreated       PdfDecisionGoldSetItem[]          @relation("PdfDecisionGoldSetCreatedBy")
  pdfDecisionGoldSetUpdated       PdfDecisionGoldSetItem[]          @relation("PdfDecisionGoldSetUpdatedBy")
  pdfModelArtifactSnapshots       PdfModelArtifactSnapshot[]
  pdfModelCandidatesCreated       PdfModelCandidate[]               @relation("PdfModelCandidateCreatedBy")
  pdfModelCandidateDecisions      PdfModelCandidateDecision[]       @relation("PdfModelCandidateDecisionUser")
  adminNotifications              AdminNotification[]               @relation("AdminNotificationRecipient")
  confidenceThresholdApplied      ConfidenceThresholdVersion[]      @relation("ConfidenceThresholdAppliedBy")
  confidenceThresholdRejected     ConfidenceThresholdVersion[]      @relation("ConfidenceThresholdRejectedBy")
  mlModelApplied                  MlModelVersion[]                  @relation("MlModelAppliedBy")
  mlModelRejected                 MlModelVersion[]                  @relation("MlModelRejectedBy")
  userRoleChangesMade             UserRoleChangeAudit[]             @relation("UserRoleChangeAuditActor")
  userRoleChangesReceived         UserRoleChangeAudit[]             @relation("UserRoleChangeAuditTarget")
  newsRelevanceFeedback           NewsRelevanceFeedback[]
  companyEventFeedback            CompanyEventFeedback[]
  companyEventExposureFeedback    CompanyEventExposureFeedback[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  plan                 String             @default("free")
  status               SubscriptionStatus @default(FREE)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserProfile {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  displayName               String?
  profileImageUrl           String?
  professionalBio           String?
  jobTitle                  String?
  employerName              String?
  employerOrgNumber         String?
  employerLogoUrl           String?
  employerSector            String?
  employerMatchedCompanyId  String?
  isStudent                 Boolean   @default(false)
  universityName            String?
  degree                    String?
  studyFocus                String?
  graduationYear            Int?
  internshipInterest        String?
  workEmail                 String?
  phoneNumber               String?
  countryOfOrigin           String?
  countryOfWork             String?
  currentLocation           String?
  linkedinProfileUrl        String?
  linkedinConnected         Boolean   @default(false)
  linkedinProviderAccountId String?
  profileCompletenessScore  Int       @default(0)
  onboardingCompleted       Boolean   @default(false)
  onboardingCompletedAt     DateTime?
  onboardingStep            Int       @default(1)
  expertiseAreas            Json?
  sectorsOfInterest         Json?
  education                 Json?
  careerHistory             Json?
  fieldSources              Json?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  employerMatchedCompany    Company?  @relation(fields: [employerMatchedCompanyId], references: [id], onDelete: SetNull)

  @@index([employerMatchedCompanyId])
  @@index([onboardingCompleted, onboardingStep])
  @@index([linkedinConnected])
}

model Workspace {
  id                   String                    @id @default(cuid())
  name                 String
  type                 WorkspaceType
  status               WorkspaceStatus           @default(ACTIVE)
  personalOwnerId      String?                   @unique
  archivedAt           DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  personalOwner        User?                     @relation("PersonalWorkspaceOwner", fields: [personalOwnerId], references: [id], onDelete: SetNull)
  lastUsedByUsers      User[]                    @relation("LastWorkspace")
  members              WorkspaceMember[]
  invitations          WorkspaceInvitation[]
  ddRooms              DdRoom[]
  watches              WorkspaceWatch[]
  industryWatches      WorkspaceIndustryWatch[]
  watchGroups          WorkspaceWatchGroup[]
  petroleumWatches     PetroleumWorkspaceWatch[]
  notifications        WorkspaceNotification[]
  monitors             WorkspaceMonitor[]
  companyEventFeedback CompanyEventFeedback[]

  @@index([status, type])
}

model WorkspaceMember {
  id          String              @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceMemberRole @default(MEMBER)
  joinedAt    DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId, role])
}

model WorkspaceInvitation {
  id               String                    @id @default(cuid())
  workspaceId      String
  email            String
  role             WorkspaceMemberRole       @default(MEMBER)
  token            String                    @unique
  status           WorkspaceInvitationStatus @default(PENDING)
  expiresAt        DateTime
  respondedAt      DateTime?
  invitedByUserId  String
  acceptedByUserId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  workspace        Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy        User                      @relation("WorkspaceInvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  acceptedBy       User?                     @relation("WorkspaceInvitationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([email, status])
}

model Company {
  id                        String                            @id @default(cuid())
  slug                      String                            @unique
  orgNumber                 String                            @unique
  name                      String
  legalForm                 String?
  status                    CompanyStatus                     @default(ACTIVE)
  statusObservedAt          DateTime?
  registeredAt              DateTime?
  foundedAt                 DateTime?
  website                   String?
  employeeCount             Int?
  revenue                   Int?
  operatingProfit           Int?
  netIncome                 Int?
  equity                    Int?
  description               String?
  sourceSystem              String
  sourceEntityType          String
  sourceId                  String
  fetchedAt                 DateTime
  normalizedAt              DateTime
  rawPayload                Json?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  addresses                 Address[]
  roles                     Role[]
  financialStatements       FinancialStatement[]
  annualReportFilings       AnnualReportFiling[]
  financialExtractionRuns   FinancialExtractionRun[]
  financialFacts            FinancialFact[]
  financialValidationIssues FinancialValidationIssue[]
  annualReportReviews       AnnualReportReview[]
  shareholdingSnapshots     ShareholdingSnapshot[]
  linkedShareholders        Shareholder[]
  ownerships                Ownership[]
  ddRooms                   DdRoom[]
  ddCommentThreads          DdCommentThread[]
  ddFindingEvidence         DdFindingEvidence[]
  workspaceWatches          WorkspaceWatch[]
  workspaceWatchGroupMembers WorkspaceWatchGroupMember[]
  petroleumWatches          PetroleumWorkspaceWatch[]
  workspaceNotifications    WorkspaceNotification[]
  distressProfile           CompanyDistressProfile?
  distressFinancialSnapshot DistressFinancialSnapshot?
  financialCoverage         CompanyFinancialCoverage?
  petroleumExposureSnapshot PetroleumCompanyExposureSnapshot?
  annualReportReviewedFacts AnnualReportReviewedFact[]
  rawLineItems              RawFinancialLineItem[]
  publishedLineItems        PublishedFinancialLineItem[]
  narratives                AnnualReportNarrative[]
  newsArticles              NewsArticleCompany[]
  newsRelevanceScores       NewsArticleRelevance[]
  newsFeatureSets           NewsArticleFeatureSet[]
  newsRelevanceFeedback     NewsRelevanceFeedback[]
  newsSignals               NewsSignal[]
  companyEvents             CompanyEvent[]
  companyEventExposures     CompanyEventExposure[]
  exposureGraphEdges        CompanyExposureGraphEdge[]
  newsIssuerIdentities      NewsIssuerIdentity[]
  matchedUserProfiles       UserProfile[]
  industryCodeId            String?
  industryCode              IndustryCode?                     @relation(fields: [industryCodeId], references: [id])

  @@index([name])
  @@index([orgNumber])
  @@index([status])
}

model CompanyDistressProfile {
  id                          String         @id @default(cuid())
  companyId                   String         @unique
  distressStatus              DistressStatus
  statusStartedAt             DateTime?
  statusObservedAt            DateTime
  daysInStatus                Int?
  bankruptcyDate              DateTime?
  liquidationDate             DateTime?
  forcedProcessDate           DateTime?
  reconstructionDate          DateTime?
  foreignInsolvencyDate       DateTime?
  lastAnnouncementPublishedAt DateTime?
  lastAnnouncementTitle       String?
  sourceSystem                String
  sourceEntityType            String
  sourceId                    String
  fetchedAt                   DateTime
  normalizedAt                DateTime
  rawPayload                  Json?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  company                     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([distressStatus, daysInStatus])
  @@index([statusStartedAt])
