// Editable alias mapping: which normalized Norwegian labels route to each
// canonical metric key. Source of truth for findCanonicalMetricKey at runtime,
// edited through the admin metric-mapping flow chart. The canonical key set
// itself (CanonicalMetricKey) stays fixed in code.
model MetricAlias {
  id               String   @id @default(cuid())
  metricKey        String
  alias            String
  normalizedAlias  String
  statementFamily  String
  liabilitySection String?
  isActive         Boolean  @default(true)
  createdByUserId  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([metricKey, normalizedAlias, liabilitySection])
  @@index([statementFamily])
  @@index([isActive])
}

// The editable registry of canonical metric keys. Seeded from the code skeleton
// (canonicalMetricLayout + requiredPublishMetricKeys) so every key's identity,
// display metadata, layout position and publish-gating flag live in data, not
// code. A rename in the admin hub updates the `key` here too, so nothing in the
// code skeleton is left referencing the old name. When the table is empty the
// services fall back to the built-in code skeleton.
model CanonicalKey {
  id               String   @id @default(cuid())
  key              String   @unique
  label            String
  family           String // INCOME_STATEMENT | BALANCE_SHEET
  layoutGroup      String // MetricLayoutGroup, e.g. DRIFTSINNTEKTER
  nodeType         String   @default("line") // line | subtotal | total
  liabilitySection String? // LONG_TERM | CURRENT | null
  isRequired       Boolean  @default(false) // part of the publish-required set
  sortOrder        Int      @default(0) // vertical order in the flow
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
  @@index([isRequired])
}

// Persisted family classification for keys that are NOT in the CanonicalKey
// registry — i.e. reviewer-created custom keys. A custom key's family is
// otherwise derived from the statementType of its facts, which is unreliable
// for balance-detail keys commonly entered on NOTE/income-typed rows (software,
// goodwill, pension_liability, …). When a reviewer sets the family in the
// canonical-key inspector, that choice is authoritative and stored here.
model CanonicalKeyFamilyOverride {
  id        String   @id @default(cuid())
  metricKey String   @unique
  family    String // INCOME_STATEMENT | BALANCE_SHEET
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A presentation node groups canonical metric keys (and/or other nodes) into a
// single line of a standardized statement. A node's value is the sum of the
// keys assigned to it plus the nodes linked into it. "SUBTOTAL" nodes are
// rendered distinctly (e.g. Sum driftsinntekter, EBITDA) but share the model.
model PresentationNode {
  id              String   @id @default(cuid())
  label           String
  kind            String   @default("LINE") // LINE | SUBTOTAL
  positionX       Float    @default(0)
  positionY       Float    @default(0)
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  keys     PresentationNodeKey[]
  outgoing PresentationNodeLink[] @relation("NodeLinkSource")
  incoming PresentationNodeLink[] @relation("NodeLinkTarget")
}

// Assignment of a canonical metric key to exactly one presentation node.
// metricKey is the primary key, enforcing the "a key belongs to one node" rule.
model PresentationNodeKey {
  metricKey String           @id
  nodeId    String
  valueMode String           @default("NOMINAL") // NOMINAL | ABSOLUTE — whether the fact's signed value or its absolute value is used
  operation String           @default("ADD") // ADD | SUBTRACT | MULTIPLY | DIVIDE | MATCH — how this key folds into the node value
  node      PresentationNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId])
}

// A directed link from a source node into a target (subtotal) node: the source
// node's value rolls up into the target.
model PresentationNodeLink {
  id           String           @id @default(cuid())
  sourceNodeId String
  targetNodeId String
  operation    String           @default("ADD") // ADD | SUBTRACT — sign of the source in the target subtotal
  source       PresentationNode @relation("NodeLinkSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  target       PresentationNode @relation("NodeLinkTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([sourceNodeId, targetNodeId])
  @@index([targetNodeId])
}

