  @@index([exposureId, reviewedAt(sort: Desc)])
  @@index([userId, reviewedAt(sort: Desc)])
  @@index([label, reviewedAt(sort: Desc)])
}

model CompanyExposureGraphNode {
  id               String   @id @default(cuid())
  nodeType         String
  key              String
  label            String
  description      String?
  metadata         Json?
  sourceSystem     String
  sourceEntityType String
  sourceId         String
  fetchedAt        DateTime
  normalizedAt     DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companyEdges CompanyExposureGraphEdge[]

  @@unique([nodeType, key])
  @@index([nodeType, label])
  @@index([sourceSystem, sourceEntityType])
}

model CompanyExposureGraphEdge {
  id               String   @id @default(cuid())
  companyId        String
  nodeId           String
  relationType     String
  weight           Float    @default(0)
  confidenceScore  Float    @default(0)
  rationale        String?
  metadata         Json?
  sourceSystem     String
  sourceEntityType String
  sourceId         String
  fetchedAt        DateTime
  normalizedAt     DateTime
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  node    CompanyExposureGraphNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([companyId, nodeId, relationType])
  @@index([companyId, active, weight(sort: Desc)])
  @@index([nodeId, active, weight(sort: Desc)])
  @@index([sourceSystem, sourceEntityType])
}

model CompanyEventFeedback {
  id             String            @id @default(cuid())
  eventId        String
  userId         String
  workspaceId    String?
  label          NewsFeedbackLabel
  action         String            @default("relevant")
  previousValue  Json?
  correctedValue Json?
  notes          String?
  reviewedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  event     CompanyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?   @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([eventId, reviewedAt(sort: Desc)])
  @@index([userId, reviewedAt(sort: Desc)])
  @@index([workspaceId, reviewedAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
}

// AdminNotification represents an item that needs attention from a platform administrator
// or financial reviewer — for example, "a new calibration proposal is waiting for your approval".
// Notifications are scoped by role (so e.g. all admins see calibration proposals) and can
// optionally be targeted at a specific user. They surface in the global header bell.
//
// dedupeKey prevents the same logical event being recorded twice (e.g. the same calibration
// proposal can only generate one notification regardless of how many times the job runs).
model AdminNotification {
  id              String                  @id @default(cuid())
  type            AdminNotificationType
  recipientRole   AppRole
  recipientUserId String?
  title           String
  body            String
  linkPath        String
  dedupeKey       String                  @unique
  status          AdminNotificationStatus @default(UNREAD)
  metadata        Json?
  createdAt       DateTime                @default(now())
  readAt          DateTime?
  dismissedAt     DateTime?

  recipient User? @relation("AdminNotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientRole, status, createdAt])
  @@index([recipientUserId, status])
  @@index([type, createdAt])
}

model UserRoleChangeAudit {
  id           String   @id @default(cuid())
  actorUserId  String
  targetUserId String
  fromRole     AppRole
  toRole       AppRole
  reason       String?
  createdAt    DateTime @default(now())

  actor  User @relation("UserRoleChangeAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target User @relation("UserRoleChangeAuditTarget", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@index([actorUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

// ConfidenceThresholdVersion stores a versioned snapshot of the confidence-gate
// configuration that decides which extraction results are auto-published vs sent
// to manual review. Each row is a complete snapshot of all thresholds and
// decisions — we don't store individual field changes — so rolling back is just
// "make the previous row ACTIVE again".
//
// At most one row should have status=ACTIVE at any time. The version number is
// auto-incremented and shown to reviewers as a human-friendly identifier (v1, v2…).
//
// `configBlob` carries the full UnifiedExtractionConfidenceGateConfig (numeric
// thresholds + categorical decisions). `derivedFromReport` carries a snapshot of
// the calibration report that produced this proposal, so an admin can later see
// "this proposal was based on 234 reviews from the last 14 days".
//
// `impactEstimate` is a small summary (e.g. estimated auto-publish rate) shown
// in the UI so reviewers can judge a proposal without opening the full report.
model ConfidenceThresholdVersion {
  id                String                    @id @default(cuid())
  version           Int                       @unique @default(autoincrement())
  status            ConfidenceThresholdStatus @default(PROPOSED)
  configBlob        Json
  derivedFromReport Json?
  impactEstimate    Json?
  summary           String?
  notes             String?
  proposedAt        DateTime                  @default(now())
  appliedAt         DateTime?
  appliedByUserId   String?
  retiredAt         DateTime?
  rejectedAt        DateTime?
  rejectedByUserId  String?
  rejectionReason   String?

  appliedBy  User? @relation("ConfidenceThresholdAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("ConfidenceThresholdRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@index([status, version])
  @@index([proposedAt])
}

// Categorises the kind of correction a reviewer made. Used to group similar
// extraction mistakes so we can see *what kind* of error happens most often
// (e.g. "units are wrong by a factor of 1000" vs "OCR misread a digit").
enum ExtractionPatternErrorClass {
  // The machine value is off by a factor of ~1000 — usually a units-of-NOK
  // detection failure.
  UNIT_SCALE_MISS
  // Similar magnitudes but different digits — typical of OCR character errors.
  OCR_NOISE
  // Machine extracted nothing where the reviewer entered a value.
  MISSING_VALUE
  // Same value but a different source page — likely page-classification error.
  WRONG_PAGE
  // Anything else — kept so nothing is lost to mis-classification.
  OTHER
}

enum ExtractionPatternReportStatus {
  ACTIVE
  ARCHIVED
}

// One ExtractionPatternReport is the result of an aggregation run over a
// specific time window of reviewer corrections. Reports accumulate over time
// so the admin UI can show "the most recent picture" and the change over time.
// `totalCorrections` is the denominator the UI uses for "X out of Y were unit
// scale errors" stats.
model ExtractionPatternReport {
  id               String                        @id @default(cuid())
  periodStart      DateTime
  periodEnd        DateTime
  generatedAt      DateTime                      @default(now())
  status           ExtractionPatternReportStatus @default(ACTIVE)
  totalCorrections Int                           @default(0)
  notes            String?

  patterns ExtractionPattern[]

  @@index([status, generatedAt])
  @@index([generatedAt])
}

// One row per "kind of error × metric × rule" combination. Sorted by
// occurrence count and severity so the UI surfaces the biggest issues first.
// `affectedFilings` carries a capped sample (up to 50) for drill-down without
// blowing up row size on large reports.
model ExtractionPattern {
  id              String                      @id @default(cuid())
  reportId        String
  metricKey       String?
  ruleCode        String?
  errorClass      ExtractionPatternErrorClass
  occurrenceCount Int
  severityScore   Float
  affectedFilings String[]
  suggestedFix    String?

  report ExtractionPatternReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([errorClass, occurrenceCount])
}

// MlTaskType identifies *which* extraction problem a model solves. Each task
// type is independently versioned so we can replace the unit-scale classifier
// without touching the page-type classifier.
enum MlTaskType {
  UNIT_SCALE_CLASSIFIER
  PAGE_TYPE_CLASSIFIER
  YEAR_COLUMN_DETECTOR
  OTHER
}

// Identical lifecycle to ConfidenceThresholdVersion — PROPOSED awaits human
// approval, ACTIVE is in production (at most one per task type), RETIRED was
// superseded, REJECTED was turned down.
enum MlModelStatus {
  PROPOSED
  ACTIVE
  RETIRED
  REJECTED
}

// MlModelVersion stores one trained model per row. The model binary itself is
// kept in the inference container's volume; this row carries the metadata,
// evaluation metrics, and pointers needed to find the binary.
//
// Versioning is per-task: each task type has its own incrementing version
// number, so you can have unit-scale v3 and page-type v1 active at the same
// time.
//
// `evaluationMetrics` is a free-form JSON blob with the training script's
// output — typically { precision, recall, f1, accuracy, confusionMatrix }.
// `trainingDataSnapshot` records what data the model saw, so future audits
// can answer "what was this model trained on?".
//
// `binaryPath` is the path inside the inference container's volume — it's
// the contract between the trainer (writes the file) and the inference
// service (reads it). The DB never stores the binary itself.
model MlModelVersion {
  id                   String        @id @default(cuid())
  taskType             MlTaskType
  taskVersion          Int // per-task incrementing version, set by the service
  status               MlModelStatus @default(PROPOSED)
  algorithm            String // e.g. "tfidf+logreg", "nb-bert-finetuned"
  binaryPath           String // path to the model file in the inference volume
  evaluationMetrics    Json?
  trainingDataSnapshot Json?
  summary              String?
  notes                String?
  proposedAt           DateTime      @default(now())
  appliedAt            DateTime?
  appliedByUserId      String?
  retiredAt            DateTime?
  rejectedAt           DateTime?
  rejectedByUserId     String?
  rejectionReason      String?

  appliedBy  User? @relation("MlModelAppliedBy", fields: [appliedByUserId], references: [id], onDelete: SetNull)
  rejectedBy User? @relation("MlModelRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@unique([taskType, taskVersion])
  @@index([taskType, status])
  @@index([proposedAt])
}

// IngestionRun tracks one bulk filing-ingestion job (the bulk-ingest-filings
// script). It exists so the admin UI can show "an ingestion is running, N of
// M filings done" even after the script's terminal is closed — the progress
// lives in the database, not the process.
//
// The script creates a row at start (status RUNNING), updates the counters
// as it works, and sets COMPLETED/FAILED at the end. On completion an
// AdminNotification is raised so the bell shows the result.
model IngestionRun {
  id               String             @id @default(cuid())
  status           IngestionRunStatus @default(RUNNING)
  startedAt        DateTime           @default(now())
  finishedAt       DateTime?
  triggeredBy      String?
  totalCompanies   Int
  totalFilings     Int                @default(0)
  processedFilings Int                @default(0)
  publishedCount   Int                @default(0)
  reviewCount      Int                @default(0)
  failedCount      Int                @default(0)
  notes            String?

  @@index([status, startedAt])
}
