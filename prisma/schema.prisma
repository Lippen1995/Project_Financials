// Categories of admin-targeted notifications surfaced in the global bell. Each value
// represents a distinct kind of event the system asks an administrator to look at —
// typically a proposal that needs human approval, or a pattern that's worth reviewing.
enum AdminNotificationType {
  CALIBRATION_PROPOSED
  PATTERN_DETECTED
  TRAINING_MILESTONE
  ENGINE_PROMOTION_OBSERVED
  INGESTION_COMPLETED
}

// Lifecycle of a bulk ingestion run (the bulk-ingest-filings script).
enum IngestionRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AdminNotificationStatus {
  UNREAD
  READ
  DISMISSED
}

enum NewsFeedbackLabel {
  RELEVANT
  NOT_RELEVANT
  WEAK_RELEVANT
}

// Lifecycle of a calibration threshold version.
//   PROPOSED: written by the calibration service, awaiting human approval.
//   ACTIVE:   currently used by the extraction pipeline. At most one row may
//             have this status at a time.
//   RETIRED:  superseded by a newer ACTIVE version that has taken its place.
//   REJECTED: a proposal the reviewer explicitly turned down.
enum ConfidenceThresholdStatus {
  PROPOSED
  ACTIVE
  RETIRED
  REJECTED
}

enum WorkspaceMonitorStatus {
  ACTIVE
  ARCHIVED
}

