  @@index([taxYear, issuerOrgNumber])
  @@index([taxYear, shareholderOrgNumber])
  @@index([taxYear, issuerOrgNumber, shareholderOrgNumber])
  @@index([issuerOrgNumber])
  @@index([shareholderOrgNumber])
  @@index([taxYear, ownershipPercent])
}

/// Materialised company-to-company ownership graph, aggregated per tax year from
/// ShareholderRegisterHolding (share classes summed). Only org->org edges are stored;
/// person shareholders terminate the chain and are read directly from the register.
/// Built by server/ownership/ownership-edge-builder.ts (npm run ownership:build-edges).
model OwnershipEdge {
  taxYear           Int
  issuerOrgNumber   String                @db.VarChar(9) // the company that is owned
  ownerOrgNumber    String                @db.VarChar(9) // the corporate owner
  issuerName        String
  ownerName         String
  aggregatedShares  BigInt // summed across share classes for this owner/issuer pair
  totalIssuerShares BigInt?
  ownershipPercent  Decimal?              @db.Decimal(9, 6) // aggregatedShares / totalIssuerShares * 100
  relationship      OwnershipRelationship
  builtAt           DateTime              @default(now())

  @@id([taxYear, issuerOrgNumber, ownerOrgNumber])
  @@index([taxYear, ownerOrgNumber]) // downward traversal: what does X own
  @@index([taxYear, issuerOrgNumber]) // upward traversal: who owns X
  @@index([taxYear, ownerOrgNumber, relationship])
}

