model AnnualReportReviewedFact {
  id               String                       @id @default(cuid())
  reviewId         String
  filingId         String
  extractionRunId  String?
  companyId        String
  fiscalYear       Int
  metricKey        String
  statementType    FinancialFactStatementType
  statementScope   StatementScope               @default(COMPANY)
  value            BigInt?
  // The reviewer's on-screen "Endelig" (manual ?? machine), persisted verbatim
  // from the review grid. This is the single authoritative number that gets
  // published; `value` mirrors it. correctionSource records only provenance.
  finalInput       BigInt?
  currency         String                       @default("NOK")
  unitScale        Int                          @default(1)
  sourcePage       Int?
  rawLabel         String?
  correctionSource ReviewedFactCorrectionSource
  reviewerUserId   String
  createdAt        DateTime                     @default(now())

  review   AnnualReportReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  filing   AnnualReportFiling @relation(fields: [filingId], references: [id], onDelete: Cascade)
  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewer User               @relation("ReviewedFactReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  // metricKey is not unique per line — distinct rows can share a key
  // (e.g. inngående vs utgående egenkapital both map to total_equity). The
  // line identity includes the human-reviewed label, so two such rows persist
  // as separate facts instead of one silently overwriting the other.
  @@unique([reviewId, metricKey, statementScope, fiscalYear, rawLabel])
  @@index([reviewId, metricKey])
  @@index([companyId, fiscalYear, metricKey])
}

