model DistressSyncState {
  id              String    @id @default(cuid())
  key             String    @unique
  lastUpdateId    Int?
  lastRunAt       DateTime?
  lastBootstrapAt DateTime?
  etag            String?
  lastModified    String?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model PipelineJobLease {
  id              String    @id @default(cuid())
  jobKey          String    @unique
  leaseOwner      String
  leaseAcquiredAt DateTime
  leaseExpiresAt  DateTime
  lastHeartbeatAt DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([jobKey, leaseExpiresAt])
}

model Person {
  id               String   @id @default(cuid())
  fullName         String
  birthYear        Int?
  sourceSystem     String
  sourceEntityType String
  sourceId         String
  fetchedAt        DateTime
  normalizedAt     DateTime
  rawPayload       Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  roles            Role[]
}

model Role {
  id               String    @id @default(cuid())
  title            String
  isBoardRole      Boolean   @default(false)
  fromDate         DateTime?
  toDate           DateTime?
  sourceSystem     String
  sourceEntityType String
  sourceId         String
  fetchedAt        DateTime
  normalizedAt     DateTime
  rawPayload       Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  companyId        String
  personId         String
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  person           Person    @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([companyId, title])
}

model FinancialStatement {
  id                    String                              @id @default(cuid())
  fiscalYear            Int
  statementScope        StatementScope                      @default(COMPANY)
  currency              String                              @default("NOK")
  revenue               BigInt?
  operatingProfit       BigInt?
  netIncome             BigInt?
  equity                BigInt?
  assets                BigInt?
  sourceSystem          String
  sourceEntityType      String
  sourceId              String
  fetchedAt             DateTime
  normalizedAt          DateTime
  rawPayload            Json?
  sourceFilingId        String?
  sourceExtractionRunId String?
  qualityStatus         FinancialStatementQualityStatus     @default(MANUAL_REVIEW)
  qualityScore          Float?
  unitScale             Int?
  sourcePrecedence      FinancialStatementSourcePrecedence?
  publishedAt           DateTime?
  createdAt             DateTime                            @default(now())
  updatedAt             DateTime                            @updatedAt
  companyId             String
  company               Company                             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceFiling          AnnualReportFiling?                 @relation("PublishedStatementFiling", fields: [sourceFilingId], references: [id], onDelete: SetNull)
  sourceExtractionRun   FinancialExtractionRun?             @relation("PublishedStatementExtractionRun", fields: [sourceExtractionRunId], references: [id], onDelete: SetNull)
  ddCommentThreads      DdCommentThread[]
  ddFindingEvidence     DdFindingEvidence[]

  @@unique([companyId, fiscalYear, statementScope])
  @@index([companyId, fiscalYear])
  @@index([sourceFilingId])
  @@index([sourceExtractionRunId])
}

// Public "as reported" financial statement line items. Machine extraction may
// publish here after document-level gates pass; manual review rows have
// precedence and are not overwritten by later machine reprocesses.
model PublishedFinancialLineItem {
  id             String                     @id @default(cuid())
  companyId      String
  filingId       String
  fiscalYear     Int
  statementType  FinancialFactStatementType
  statementScope StatementScope             @default(COMPANY)
  metricKey      String?
  rawLabel       String?
  originalLabel  String?
  originalValue  String?
  parsedValue    BigInt?
  value          BigInt?
  // The authoritative published number: the reviewer's on-screen "Endelig"
  // (manual ?? machine), persisted verbatim from the review grid. `value`
  // mirrors it for back-compat; publishing sources the figure from finalInput.
  finalInput     BigInt?
  currency       String                     @default("NOK")
  unitScale      Int                        @default(1)
  sourcePage     Int?
