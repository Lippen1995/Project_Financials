// Distinguishes which set of accounts a financial figure belongs to.
//   COMPANY:      the legal entity's own accounts (selskapsregnskap). For a
//                 standalone company this is its only set; for a group parent
//                 this is the "morregnskap".
//   CONSOLIDATED: the group accounts (konsernregnskap) — the parent plus all
//                 subsidiaries combined. Only present for group parents.
// Most Norwegian companies have only COMPANY. Existing rows default to COMPANY.
enum StatementScope {
  COMPANY
  CONSOLIDATED
}

enum FinancialValidationSeverity {
  INFO
  WARNING
  ERROR
}

enum CompanyFinancialCoverageStatus {
  UNCHECKED
  DISCOVERED
  PARTIAL
  PUBLISHED
  FAILED
  MANUAL_REVIEW
}

